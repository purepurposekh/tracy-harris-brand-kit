{
  "name": "tracy-harris-brand-kit",
  "version": "1.0.0",
  "description": "Brand system for Tracy Harris Co, FFB, FFM, and FRESH.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "design-md": "node scripts/generate-design-md.mjs",
    "design-md:lint": "design.md lint exports/design-md/tracy.md && design.md lint exports/design-md/ffb.md && design.md lint exports/design-md/ffm.md && design.md lint exports/design-md/fresh.md",
    "design-md:export-tailwind": "design.md export --format tailwind exports/design-md/tracy.md > exports/tailwind-tracy.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purepurposekh/tracy-harris-brand-kit.git"
  },
